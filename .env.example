# Local app
APP_URL=http://localhost:5173
API_URL=http://localhost:3031
DB_PATH=./database

# Optional free/self-hosted SERP providers for rank checks and SERP analysis.
OPENSERP_URL=
SEARXNG_URL=

# Optional Google Search Console OAuth. Keep secrets in .env; Settings only shows status.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Google PageSpeed Insights key for Core Web Vitals (works keyless with a small quota).
PAGESPEED_API_KEY=

# In-process scheduler for scheduled scans and rank checks (all schedules are off until set).
# SCHEDULER_TICK_MS=60000
# SCHEDULER_DISABLED=1

# Optional local MCP guard. If set, MCP clients must send Authorization: Bearer ...
MCP_TOKEN=

# Local Codex AI jobs
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_MS=600000
